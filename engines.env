# Engine releases bundled into iniaku-miner packages (all open source).
XMRIG_REPO=IniAku/xmrig-iniaku
XMRIG_VERSION=6.24.0-iniaku.3-beta.3
EPIC_MINER_REPO=IniAku/Epic-Miner-Iniaku
EPIC_MINER_VERSION=2.3.1-iniaku.16-beta
# CUDA plugin for XMRig (GPU fallback, e.g. KawPow on NVIDIA): official build on Windows,
# IniAku/xmrig-cuda build on Linux.
XMRIG_CUDA_WIN_URL=https://github.com/xmrig/xmrig-cuda/releases/download/v6.22.1/xmrig-cuda-6.22.1-cuda12_9-win64.zip
XMRIG_CUDA_LINUX_REPO=IniAku/xmrig-cuda
XMRIG_CUDA_LINUX_VERSION=6.22.1-iniaku.1-beta
# Quantus engine for the GPU fallback ("algo": "quantus")
QUANTUS_REPO=IniAku/quantus-miner
QUANTUS_VERSION=4.2.1-iniaku.4-beta
